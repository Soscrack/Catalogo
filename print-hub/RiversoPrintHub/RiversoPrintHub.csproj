<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- windows10.0.19041 habilita Windows.Data.Pdf (render de PDF nativo de Windows, sin librerías externas). -->
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <AssemblyName>RiversoPrintHub</AssemblyName>
    <RootNamespace>RiversoPrintHub</RootNamespace>
    <Version>1.0.0</Version>
    <Product>Riverso Print Hub</Product>
    <Company>Riverso</Company>
  </PropertyGroup>

</Project>
